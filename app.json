{
  "expo": {
    "name": "PLANTIX",
    "slug": "PLANTIX",
    "scheme": "plantix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/hojitas.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img/hojitas.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jsuarez219.PLANTIX",
